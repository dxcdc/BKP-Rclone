# ==============================================================================
# CONFIGURAÇÃO GERAL - CENTRAL DE BACKUP (GITOPS)
# ==============================================================================

# Senha simétrica de criptografia GPG (AES-256)
# IMPORTANTE: Guarde essa senha em local seguro (Ex: Vaultwarden).
# Sem ela, será impossível descriptografar e recuperar os backups.
GPG_PASSPHRASE="<TODO: DEFINIR — Insira uma frase secreta muito forte>"

# URL do Webhook do Mattermost para alertas operacionais (Opcional)
# Ex: https://mattermost.empresa.com/hooks/xxxxxx
MATTERMOST_WEBHOOK_URL=""

# Retenção padrão de backups no Google Drive (em dias)
DEFAULT_RETENTION_DAYS=15

# A retenção destrutiva só começa quando houver mais que este número de backups.
MINIMUM_REMOTE_BACKUPS=2

# Raiz do destino. Pode apontar para outro remote em homologação/testes.
RCLONE_REMOTE_ROOT="gdrive:Central de BKP"

# Arquivo usado pelo flock para impedir execuções concorrentes.
BACKUP_LOCK_FILE="/tmp/cdc-backup.lock"
